{
  "name": "@superdesign/cli",
  "version": "0.14.0",
  "description": "CLI for SuperDesign Platform - agent skills for Claude Code",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "superdesign": "./bin/superdesign.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "rslib build && chmod +x bin/superdesign.js",
    "dev": "rslib build --watch",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "commander": "^11.1.0",
    "dotenv": "^16.3.0",
    "open": "^10.0.0",
    "ora": "^8.0.0",
    "posthog-node": "^5.44.0"
  },
  "devDependencies": {
    "@rslib/core": "0.15.1",
    "@superdesign/types": "workspace:*",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "superdesign",
    "cli",
    "claude-code",
    "ai",
    "design"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/superdesigndev/superdesign-platform.git",
    "directory": "packages/cli"
  },
  "license": "MIT"
}
